{
  "id": "secret-env-edit",
  "title": "Editing a secrets / .env file",
  "pattern": "secret-env-edit",
  "category": "security",
  "concepts": ["secret-exposure", "git-history-permanence", "credential-rotation"],
  "mechanism": "Secrets are safe only while nothing durable records them. A credential written into a file is one `git add` away from being permanent: git history keeps every committed version forever, and pushes replicate that history to every clone and mirror.",
  "consequence": "If the file is (or ever becomes) tracked, the secret enters history, and deleting it in a later commit does not remove the exposure. A secret that touched history must be treated as leaked and rotated — scrubbing tools can't reach clones that already pulled.",
  "selection": {
    "question": "An API key gets written into a file in this repo. What actually decides whether that key ends up exposed?",
    "options": [
      {
        "text": "Whether the repo is private — private repo, private key.",
        "misconception": "Private repos get forked, cloned to laptops, granted to CI and third-party apps, and sometimes flipped public later. Privacy is a setting; history is forever."
      },
      {
        "text": "Whether the file ever gets committed: once a secret is in git history, removing it later doesn't undo the exposure — only rotating the credential does.",
        "correct": true
      },
      {
        "text": "Nothing to decide — it's in .gitignore, so git can never see it.",
        "misconception": ".gitignore only stops *untracked* files from being suggested. It doesn't apply to files already tracked, doesn't rewrite history, and doesn't stop `git add -f`."
      },
      {
        "text": "Whether you delete the line before anyone reads the file.",
        "misconception": "Deleting the line creates a new version; the old version stays in history (and in every clone/mirror that fetched it). Exposure isn't about the current state — it's about every state that ever existed."
      }
    ]
  }
}
